{
  "name": "proshop",
  "version": "1.0.0",
  "description": "eCommerce application built with the MERN-stack",
  "homepage": "https://github.com/joerylander/proshop#readme",
  "bugs": {
    "url": "https://github.com/joerylander/proshop/issues"
  },
  "repository": {
    "type": "git",
