  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0"
  }
